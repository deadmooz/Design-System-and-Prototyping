# Copy to .env and fill in only what you use — or add keys in the workspace
# under Settings, which writes them here. Keys stay on the server; the
# workspace UI never sees them. Any provider without a key is shown as
# "not configured" and the built-in offline "mock" provider is always available.

# --- LLM providers ---------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional model overrides (defaults live in src/llm/registry.ts)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-5
# GEMINI_MODEL=gemini-3.5-flash-lite
# XAI_MODEL=grok-4

# Provider used when the request does not name one: mock | anthropic | openai | gemini | xai
DEFAULT_PROVIDER=mock

# --- Figma -----------------------------------------------------------------
# Personal access token (Figma > Settings > Security). Can also be supplied per
# request from the workspace; it is never stored server-side.
FIGMA_TOKEN=

# --- Server ----------------------------------------------------------------
PORT=4310
HOST=127.0.0.1
# Allow the URL extractor to fetch localhost / private network addresses.
# Keep false unless you are extracting from your own local dev server.
ALLOW_PRIVATE_NETWORK=false
